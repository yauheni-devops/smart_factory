# Local development only. Copy to .env and change these values before exposing services.
# Reserved for a later PostgreSQL migration; current Compose uses SQLite.
# POSTGRES_DB=maintenance
# POSTGRES_USER=maintenance
# POSTGRES_PASSWORD=change-this-local-password
# Used only with: docker compose --profile observability up
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
PTO_ACCESS_USERNAME=pto
PTO_ACCESS_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
